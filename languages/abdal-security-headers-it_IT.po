#: includes/class-ash-security-status.php:1
msgid ""
"CSP is independent of Security Profiles. Enable it from the Content Security"
" Policy screen when you are ready."
msgstr ""
"CSP è indipendente dai Security Profile. Attivala dalla schermata Content "
"Security Policy quando sei pronto."

#: includes/class-ash-security-status.php:1
msgid "Content Security Policy is in Report Only mode."
msgstr "Content Security Policy è in modalità Report Only."

#: includes/class-ash-security-status.php:1
msgid ""
"Learning uses Content-Security-Policy-Report-Only and does not block "
"resources."
msgstr ""
"L’apprendimento usa Content-Security-Policy-Report-Only e non blocca le "
"risorse."

#: includes/class-ash-security-status.php:1
msgid "Content Security Policy configuration is invalid."
msgstr "La configurazione di Content Security Policy non è valida."

#: includes/class-ash-security-status.php:1
msgid "Enable at least one CSP directive before sending the header."
msgstr "Attiva almeno una direttiva CSP prima di inviare l’intestazione."

#: includes/class-ash-security-status.php:1
msgid "WordPress version hiding is enabled without generator outputs."
msgstr ""
"La protezione della versione di WordPress è attiva senza output del "
"generatore."

#: includes/class-ash-security-status.php:1
msgid "Turn on Hide Generator Meta Version or Hide Version from Feeds."
msgstr "Attiva Hide Generator Meta Version o Hide Version from Feeds."

#: includes/class-ash-security-status.php:1
msgid "Referrer-Policy is set to unsafe-url."
msgstr "Referrer-Policy è impostato su unsafe-url."

#: includes/class-ash-security-status.php:1
msgid "XML-RPC custom policy has no methods configured."
msgstr "La policy XML-RPC personalizzata non ha metodi configurati."

#: includes/class-ash-security-status.php:1
msgid ""
"Add allowed or blocked method names, or choose another protection mode."
msgstr ""
"Aggiungi nomi di metodi consentiti o bloccati, oppure scegli un’altra "
"modalità di protezione."

#: includes/class-ash-security-status.php:1
msgid "REST Selected Roles has no roles chosen."
msgstr "REST Selected Roles non ha ruoli selezionati."

#: includes/class-ash-security-status.php:1
msgid "Select at least one WordPress role or choose another access policy."
msgstr ""
"Seleziona almeno un ruolo WordPress o scegli un’altra policy di accesso."

#: includes/class-ash-security-status.php:1
msgid "X-XSS-Protection report policy is missing a reporting URL."
msgstr ""
"La policy di report di X-XSS-Protection non ha un URL di segnalazione."

#: includes/class-ash-security-status.php:1
msgid "Add a reporting URL or choose another X-XSS-Protection policy."
msgstr ""
"Aggiungi un URL di segnalazione o scegli un’altra policy X-XSS-Protection."

#: includes/class-ash-security-status.php:1
msgid "Another layer sends %s while this plugin does not."
msgstr "Un altro livello invia %s mentre questo plugin non lo fa."

#: includes/class-ash-security-status.php:1
msgid "The public %s value does not match this plugin."
msgstr "Il valore pubblico di %s non coincide con questo plugin."

#: includes/class-ash-security-status.php:1
msgctxt "CSP status"
msgid "Report Only"
msgstr "Report Only"

#: includes/class-ash-security-status.php:1
msgctxt "CSP status"
msgid "Invalid Configuration"
msgstr "Configurazione non valida"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Export or import plugin configuration, and choose what happens to stored "
"data on uninstall."
msgstr ""
"Esporta o importa la configurazione del plugin e scegli cosa succede ai dati"
" salvati in fase di disinstallazione."

#: includes/class-ash-admin-ui.php:1931
msgid "Export and Import"
msgstr "Esporta e importa"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Download a JSON file of all plugin settings, or restore them from a previous"
" export."
msgstr ""
"Scarica un file JSON con tutte le impostazioni del plugin oppure "
"ripristinale da un export precedente."

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Export includes Security Headers, Security Features, Content Security "
"Policy, Security Profile, uninstall settings, and CSP Assistant scan "
"exclusions."
msgstr ""
"L'export include Security Headers, Security Features, Content Security "
"Policy, Security Profile, impostazioni di disinstallazione ed esclusioni di "
"scansione del CSP Assistant."

#: includes/class-ash-admin-ui.php:1931
msgid "Export"
msgstr "Esporta"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Import replaces the current plugin configuration on this site. Choose a JSON"
" file exported from Abdal Security Headers."
msgstr ""
"L'importazione sostituisce la configurazione attuale del plugin su questo "
"sito. Scegli un file JSON esportato da Abdal Security Headers."

#: includes/class-ash-admin-ui.php:1931
msgid "Import cannot be undone from this screen."
msgstr "L'importazione non può essere annullata da questa schermata."

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Security Headers, Security Features, Content Security Policy, Security "
"Profile, and Settings will be overwritten."
msgstr ""
"Security Headers, Security Features, Content Security Policy, Security "
"Profile e Settings verranno sovrascritti."

#: includes/class-ash-admin-ui.php:1931
msgid "Settings JSON file"
msgstr "File JSON delle impostazioni"

#: includes/class-ash-admin-ui.php:1931
msgid "Choose file"
msgstr "Scegli file"

#: includes/class-ash-admin-ui.php:1931
msgid "No file selected"
msgstr "Nessun file selezionato"

#: includes/class-ash-admin-ui.php:1931
msgid "Import"
msgstr "Importa"

#: includes/class-ash-admin-ui.php:1931
msgid "The export does not include CSP Assistant learning data or scan jobs."
msgstr ""
"L'export non include i dati di apprendimento del CSP Assistant né i processi"
" di scansione."

#: includes/class-ash-admin-ui.php:1931
msgid "Import settings"
msgstr "Importa impostazioni"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Import will replace current plugin settings, including Security Headers, "
"Security Features, Content Security Policy, Security Profile, and Settings. "
"This cannot be undone from this screen."
msgstr ""
"L'importazione sostituirà le impostazioni attuali del plugin, inclusi "
"Security Headers, Security Features, Content Security Policy, Security "
"Profile e Settings. Non può essere annullata da questa schermata."

#: includes/class-ash-admin-ui.php:1931
msgid "Settings file downloaded."
msgstr "File delle impostazioni scaricato."

#: includes/class-ash-admin-ui.php:1931
msgid "Settings were imported. The page will reload."
msgstr "Impostazioni importate. La pagina verrà ricaricata."

#: includes/class-ash-admin-ui.php:1931
msgid "Choose a settings JSON file before importing."
msgstr "Scegli un file JSON delle impostazioni prima di importare."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings transfer could not be completed. Please try again."
msgstr "Impossibile completare il trasferimento delle impostazioni. Riprova."

#: includes/class-ash-admin-ui.php:1931
msgid "The requested settings transfer action is not valid."
msgstr "L'azione di trasferimento impostazioni richiesta non è valida."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file could not be uploaded. Please try again."
msgstr "Impossibile caricare il file delle impostazioni. Riprova."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file is empty or larger than the allowed size."
msgstr "Il file delle impostazioni è vuoto o supera la dimensione consentita."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file could not be read."
msgstr "Impossibile leggere il file delle impostazioni."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file must be a JSON export from this plugin."
msgstr ""
"Il file delle impostazioni deve essere un export JSON di questo plugin."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file is not valid JSON."
msgstr "Il file delle impostazioni non è un JSON valido."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file is not a valid Abdal Security Headers export."
msgstr ""
"Il file delle impostazioni non è un export valido di Abdal Security Headers."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file does not contain any configuration."
msgstr "Il file delle impostazioni non contiene alcuna configurazione."

#: includes/class-ash-admin-ui.php:1931
msgid "The exported Security Headers configuration is not valid."
msgstr "La configurazione Security Headers esportata non è valida."

#: includes/class-ash-admin-ui.php:1931
msgid "The exported plugin settings are not valid."
msgstr "Le impostazioni del plugin esportate non sono valide."

#: includes/class-ash-admin-ui.php:1931
msgid ""
"The settings could not be imported completely. Previous settings were kept."
msgstr ""
"Impossibile importare completamente le impostazioni. Sono state mantenute le"
" impostazioni precedenti."
