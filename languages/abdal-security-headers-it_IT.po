#: includes/class-ash-admin-ui.php
msgid "Enables the legacy browser XSS filter for older clients."
msgstr "Attiva il filtro XSS legacy per i client più vecchi."

#: includes/class-ash-admin-ui.php
msgid "Prevents browsers from MIME-sniffing a response away from the declared content type."
msgstr "Impedisce al browser di indovinare un tipo MIME diverso da quello dichiarato."

#: includes/class-ash-admin-ui.php
msgid "Forces browsers to use HTTPS for future requests to this host."
msgstr "Obbliga i browser a usare HTTPS per le richieste future a questo host."

#: includes/class-ash-admin-ui.php
msgid "Restricts access to powerful browser features such as camera and geolocation."
msgstr "Limita l’accesso a funzioni potenti del browser, come fotocamera e geolocalizzazione."

#: includes/class-ash-admin-ui.php
msgid "Controls whether the site can be embedded in frames to reduce clickjacking risk."
msgstr "Controlla se il sito può essere incorporato in frame per ridurre il clickjacking."

#: includes/class-ash-admin-ui.php
msgid "Limits referrer information sent with navigations and resource requests."
msgstr "Limita le informazioni di referrer inviate con navigazioni e richieste di risorse."

#: includes/class-ash-admin-ui.php
msgid "Hides server technology details exposed by the X-Powered-By header."
msgstr "Nasconde i dettagli della tecnologia server esposti da X-Powered-By."

#: includes/class-ash-admin-ui.php
msgid "Removes the public WordPress version from markup, feeds, scripts, and styles."
msgstr "Rimuove la versione pubblica di WordPress da markup, feed, script e stili."

#: includes/class-ash-admin-ui.php
msgid "Replaces detailed login errors with a generic message to reduce user enumeration."
msgstr "Sostituisce gli errori di accesso dettagliati con un messaggio generico per ridurre l’enumerazione degli utenti."

#: includes/class-ash-admin-ui.php
msgid "Disables XML-RPC methods and blocks direct access to xmlrpc.php."
msgstr "Disattiva i metodi XML-RPC e blocca l’accesso diretto a xmlrpc.php."

#: includes/class-ash-admin-ui.php
msgid "Removes the X-Pingback response header from WordPress output."
msgstr "Rimuove l’intestazione di risposta X-Pingback dall’output di WordPress."

#: includes/class-ash-admin-ui.php
msgid "Blocks REST API access and removes REST discovery links from the front end."
msgstr "Blocca l’accesso alla REST API e rimuove i link di discovery REST dal front-end."

