#: includes/class-ash-admin-ui.php:1931
msgid ""
"Export or import plugin configuration, and choose what happens to stored "
"data on uninstall."
msgstr ""
"Exporte o importe la configuración del plugin y elija qué ocurre con los "
"datos almacenados al desinstalarlo."

#: includes/class-ash-admin-ui.php:1931
msgid "Export and Import"
msgstr "Exportar e importar"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Download a JSON file of all plugin settings, or restore them from a previous"
" export."
msgstr ""
"Descargue un archivo JSON con todos los ajustes del plugin o restáurelos "
"desde una exportación anterior."

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Export includes Security Headers, Security Features, Content Security "
"Policy, Security Profile, uninstall settings, and CSP Assistant scan "
"exclusions."
msgstr ""
"La exportación incluye Security Headers, Security Features, Content Security"
" Policy, Security Profile, ajustes de desinstalación y exclusiones de "
"análisis del CSP Assistant."

#: includes/class-ash-admin-ui.php:1931
msgid "Export"
msgstr "Exportar"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Import replaces the current plugin configuration on this site. Choose a JSON"
" file exported from Abdal Security Headers."
msgstr ""
"La importación sustituye la configuración actual del plugin en este sitio. "
"Elija un archivo JSON exportado desde Abdal Security Headers."

#: includes/class-ash-admin-ui.php:1931
msgid "Import cannot be undone from this screen."
msgstr "La importación no se puede deshacer desde esta pantalla."

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Security Headers, Security Features, Content Security Policy, Security "
"Profile, and Settings will be overwritten."
msgstr ""
"Se sobrescribirán Security Headers, Security Features, Content Security "
"Policy, Security Profile y Settings."

#: includes/class-ash-admin-ui.php:1931
msgid "Settings JSON file"
msgstr "Archivo JSON de ajustes"

#: includes/class-ash-admin-ui.php:1931
msgid "Choose file"
msgstr "Elegir archivo"

#: includes/class-ash-admin-ui.php:1931
msgid "No file selected"
msgstr "Ningún archivo seleccionado"

#: includes/class-ash-admin-ui.php:1931
msgid "Import"
msgstr "Importar"

#: includes/class-ash-admin-ui.php:1931
msgid "The export does not include CSP Assistant learning data or scan jobs."
msgstr ""
"La exportación no incluye los datos de aprendizaje del CSP Assistant ni los "
"trabajos de análisis."

#: includes/class-ash-admin-ui.php:1931
msgid "Import settings"
msgstr "Importar ajustes"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Import will replace current plugin settings, including Security Headers, "
"Security Features, Content Security Policy, Security Profile, and Settings. "
"This cannot be undone from this screen."
msgstr ""
"La importación sustituirá los ajustes actuales del plugin, incluidos "
"Security Headers, Security Features, Content Security Policy, Security "
"Profile y Settings. No se puede deshacer desde esta pantalla."

#: includes/class-ash-admin-ui.php:1931
msgid "Settings file downloaded."
msgstr "Se ha descargado el archivo de ajustes."

#: includes/class-ash-admin-ui.php:1931
msgid "Settings were imported. The page will reload."
msgstr "Los ajustes se han importado. La página se recargará."

#: includes/class-ash-admin-ui.php:1931
msgid "Choose a settings JSON file before importing."
msgstr "Elija un archivo JSON de ajustes antes de importar."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings transfer could not be completed. Please try again."
msgstr ""
"No se ha podido completar la transferencia de ajustes. Inténtelo de nuevo."

#: includes/class-ash-admin-ui.php:1931
msgid "The requested settings transfer action is not valid."
msgstr "La acción de transferencia de ajustes solicitada no es válida."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file could not be uploaded. Please try again."
msgstr "No se ha podido subir el archivo de ajustes. Inténtelo de nuevo."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file is empty or larger than the allowed size."
msgstr "El archivo de ajustes está vacío o supera el tamaño permitido."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file could not be read."
msgstr "No se ha podido leer el archivo de ajustes."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file must be a JSON export from this plugin."
msgstr "El archivo de ajustes debe ser una exportación JSON de este plugin."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file is not valid JSON."
msgstr "El archivo de ajustes no es un JSON válido."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file is not a valid Abdal Security Headers export."
msgstr ""
"El archivo de ajustes no es una exportación válida de Abdal Security "
"Headers."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file does not contain any configuration."
msgstr "El archivo de ajustes no contiene ninguna configuración."

#: includes/class-ash-admin-ui.php:1931
msgid "The exported Security Headers configuration is not valid."
msgstr "La configuración exportada de Security Headers no es válida."

#: includes/class-ash-admin-ui.php:1931
msgid "The exported plugin settings are not valid."
msgstr "Los ajustes exportados del plugin no son válidos."

#: includes/class-ash-admin-ui.php:1931
msgid ""
"The settings could not be imported completely. Previous settings were kept."
msgstr ""
"No se han podido importar los ajustes por completo. Se han conservado los "
"ajustes anteriores."
