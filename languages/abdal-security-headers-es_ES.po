msgid "Access Policy"
msgstr "Política de acceso"

#: includes/class-ash-admin-ui.php
msgid ""
"WordPress Default applies no extra restriction. Administrators Only uses the"
" manage_options capability."
msgstr ""
"Predeterminado de WordPress no aplica restricciones extra. Solo "
"administradores usa la capacidad manage_options."

