msgid "Security Headers and Security Features are managed manually."
msgstr "Security Headers ve Security Features manuel yönetiliyor."

#: includes/class-ash-security-status.php:1
msgid "Saved profile: %1$s. Effective profile: %2$s."
msgstr "Kayıtlı profil: %1$s. Etkin profil: %2$s."

#: includes/class-ash-security-status.php:1
msgid "Current Security Profile"
msgstr "Geçerli Security Profile"

#: includes/class-ash-security-status.php:1
msgid "Active Security Features"
msgstr "Etkin güvenlik özellikleri"

#: includes/class-ash-security-status.php:1
msgid "Configuration Warnings"
msgstr "Yapılandırma uyarıları"

#: includes/class-ash-security-status.php:1
msgid "Detected Conflicts"
msgstr "Algılanan çakışmalar"

#: includes/class-ash-security-status.php:1
msgid "%1$d of %2$d headers are healthy. %3$d require attention."
msgstr "%2$d başlıktan %1$d tanesi sağlıklı. %3$d tanesi dikkat gerektiriyor."

#: includes/class-ash-security-status.php:1
msgid "%1$d of %2$d features are healthy. %3$d require attention."
msgstr ""
"%2$d özellikten %1$d tanesi sağlıklı. %3$d tanesi dikkat gerektiriyor."

#: includes/class-ash-security-status.php:1
msgid "Strong header and feature coverage for the current configuration."
msgstr "Geçerli yapılandırmada başlık ve özellik kapsamı güçlü."

#: includes/class-ash-security-status.php:1
msgid "Useful controls are on, but higher-impact settings still need review."
msgstr ""
"Yararlı kontroller açık; ancak etkisi yüksek ayarlar hâlâ incelenmeli."

#: includes/class-ash-security-status.php:1
msgid "The current configuration leaves important protections off or invalid."
msgstr ""
"Geçerli yapılandırma önemli korumaları kapalı veya geçersiz bırakıyor."

#: includes/class-ash-security-status.php:1
msgid ""
"Smart CSP Assistant is sending Content-Security-Policy-Report-Only while it "
"learns."
msgstr ""
"Smart CSP Assistant öğrenirken Content-Security-Policy-Report-Only "
"gönderiyor."

#: includes/class-ash-security-status.php:1
msgid "Content Security Policy is enabled but no directives are set."
msgstr "Content Security Policy açık ancak hiçbir yönerge ayarlanmamış."

#: includes/class-ash-security-status.php:1
msgid "HSTS is enabled while the site URL is not HTTPS."
msgstr "Site URL’si HTTPS olmadığı halde HSTS açık."

#: includes/class-ash-security-status.php:1
msgid ""
"Strict-Transport-Security is only sent over HTTPS. Serve the site over HTTPS"
" before relying on HSTS."
msgstr ""
"Strict-Transport-Security yalnızca HTTPS üzerinden gönderilir. HSTS’e "
"güvenmeden önce siteyi HTTPS ile sunun."

#: includes/class-ash-security-status.php:1
msgid "HSTS Preload is incomplete."
msgstr "HSTS Preload eksik."

#: includes/class-ash-security-status.php:1
msgid "Preload requires includeSubDomains and a max-age of at least one year."
msgstr "Preload için includeSubDomains ve en az bir yıllık max-age gerekir."

#: includes/class-ash-security-status.php:1
msgid "X-XSS-Protection is a deprecated header."
msgstr "X-XSS-Protection kullanımdan kalkmış bir başlıktır."

#: includes/class-ash-security-status.php:1
msgid ""
"Modern browsers ignore this header. Prefer Content-Security-Policy instead."
msgstr ""
"Modern tarayıcılar bu başlığı yok sayar. Bunun yerine Content-Security-"
"Policy kullanın."

#: includes/class-ash-security-status.php:1
msgid "REST API is set to Block All REST Access."
msgstr "REST API, Block All REST Access olarak ayarlı."

#: includes/class-ash-security-status.php:1
msgid ""
"Gutenberg, Site Health, plugins, themes, and integrations may stop working."
msgstr ""
"Gutenberg, Site Sağlığı, eklentiler, temalar ve entegrasyonlar çalışmayı "
"durdurabilir."

#: includes/class-ash-security-status.php:1
msgid "XML-RPC is fully disabled."
msgstr "XML-RPC tamamen devre dışı."

#: includes/class-ash-security-status.php:1
msgid ""
"Some applications and integrations that depend on XML-RPC may stop working."
msgstr ""
"XML-RPC’ye bağımlı bazı uygulamalar ve entegrasyonlar çalışmayı "
"durdurabilir."

#: includes/class-ash-security-status.php:1
msgid "Permissions-Policy has an invalid or empty configuration."
msgstr "Permissions-Policy geçersiz veya boş bir yapılandırmaya sahip."

#: includes/class-ash-security-status.php:1
msgid "The header is enabled but no valid directive is generated."
msgstr "Başlık açık ancak geçerli bir yönerge üretilmiyor."

#: includes/class-ash-security-status.php:1
msgid "A security header conflict was detected."
msgstr "Bir güvenlik başlığı çakışması algılandı."

#: includes/class-ash-security-status.php:1
msgid ""
"Another server, CDN, or plugin appears to send a security header that does "
"not match this plugin."
msgstr ""
"Başka bir sunucu, CDN veya eklenti, bu eklentiyle eşleşmeyen bir güvenlik "
"başlığı gönderiyor gibi görünüyor."

#: includes/class-ash-security-status.php:1
msgid ""
"CSP is independent of Security Profiles. Enable it from the Content Security"
" Policy screen when you are ready."
msgstr ""
"CSP, Security Profile’lardan bağımsızdır. Hazır olduğunuzda Content Security"
" Policy ekranından etkinleştirin."

#: includes/class-ash-security-status.php:1
msgid "Content Security Policy is in Report Only mode."
msgstr "Content Security Policy, Report Only modunda."

#: includes/class-ash-security-status.php:1
msgid ""
"Learning uses Content-Security-Policy-Report-Only and does not block "
"resources."
msgstr ""
"Öğrenme, Content-Security-Policy-Report-Only kullanır ve kaynakları "
"engellemez."

#: includes/class-ash-security-status.php:1
msgid "Content Security Policy configuration is invalid."
msgstr "Content Security Policy yapılandırması geçersiz."

#: includes/class-ash-security-status.php:1
msgid "Enable at least one CSP directive before sending the header."
msgstr "Başlığı göndermeden önce en az bir CSP yönergesini etkinleştirin."

#: includes/class-ash-security-status.php:1
msgid "WordPress version hiding is enabled without generator outputs."
msgstr "WordPress sürüm gizleme açık ancak generator çıktıları kapalı."

#: includes/class-ash-security-status.php:1
msgid "Turn on Hide Generator Meta Version or Hide Version from Feeds."
msgstr ""
"Hide Generator Meta Version veya Hide Version from Feeds seçeneğini açın."

#: includes/class-ash-security-status.php:1
msgid "Referrer-Policy is set to unsafe-url."
msgstr "Referrer-Policy, unsafe-url olarak ayarlı."

#: includes/class-ash-security-status.php:1
msgid "XML-RPC custom policy has no methods configured."
msgstr "XML-RPC özel politikasında yöntem yapılandırılmamış."

#: includes/class-ash-security-status.php:1
msgid ""
"Add allowed or blocked method names, or choose another protection mode."
msgstr ""
"İzin verilen veya engellenen yöntem adları ekleyin ya da başka bir koruma "
"modu seçin."

#: includes/class-ash-security-status.php:1
msgid "REST Selected Roles has no roles chosen."
msgstr "REST Selected Roles için rol seçilmemiş."

#: includes/class-ash-security-status.php:1
msgid "Select at least one WordPress role or choose another access policy."
msgstr ""
"En az bir WordPress rolü seçin veya başka bir erişim politikası belirleyin."

#: includes/class-ash-security-status.php:1
msgid "X-XSS-Protection report policy is missing a reporting URL."
msgstr "X-XSS-Protection rapor politikasında raporlama URL’si yok."

#: includes/class-ash-security-status.php:1
msgid "Add a reporting URL or choose another X-XSS-Protection policy."
msgstr ""
"Bir raporlama URL’si ekleyin veya başka bir X-XSS-Protection politikası "
"seçin."

#: includes/class-ash-security-status.php:1
msgid "Another layer sends %s while this plugin does not."
msgstr "Bu eklenti göndermezken başka bir katman %s gönderiyor."

#: includes/class-ash-security-status.php:1
msgid "The public %s value does not match this plugin."
msgstr "Herkese açık %s değeri bu eklentiyle eşleşmiyor."

#: includes/class-ash-security-status.php:1
msgctxt "CSP status"
msgid "Report Only"
msgstr "Report Only"

#: includes/class-ash-security-status.php:1
msgctxt "CSP status"
msgid "Invalid Configuration"
msgstr "Geçersiz yapılandırma"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Export or import plugin configuration, and choose what happens to stored "
"data on uninstall."
msgstr ""
"Eklenti yapılandırmasını dışa veya içe aktarın ve kaldırma sırasında kayıtlı"
" verilerin ne olacağını seçin."

#: includes/class-ash-admin-ui.php:1931
msgid "Export and Import"
msgstr "Dışa ve içe aktarma"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Download a JSON file of all plugin settings, or restore them from a previous"
" export."
msgstr ""
"Tüm eklenti ayarlarının JSON dosyasını indirin veya önceki bir dışa "
"aktarmadan geri yükleyin."

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Export includes Security Headers, Security Features, Content Security "
"Policy, Security Profile, uninstall settings, and CSP Assistant scan "
"exclusions."
msgstr ""
"Dışa aktarma; Security Headers, Security Features, Content Security Policy, "
"Security Profile, kaldırma ayarları ve CSP Assistant tarama istisnalarını "
"içerir."

#: includes/class-ash-admin-ui.php:1931
msgid "Export"
msgstr "Dışa aktar"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Import replaces the current plugin configuration on this site. Choose a JSON"
" file exported from Abdal Security Headers."
msgstr ""
"İçe aktarma, bu sitedeki mevcut eklenti yapılandırmasının yerini alır. Abdal"
" Security Headers'tan dışa aktarılmış bir JSON dosyası seçin."

#: includes/class-ash-admin-ui.php:1931
msgid "Import cannot be undone from this screen."
msgstr "İçe aktarma bu ekrandan geri alınamaz."

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Security Headers, Security Features, Content Security Policy, Security "
"Profile, and Settings will be overwritten."
msgstr ""
"Security Headers, Security Features, Content Security Policy, Security "
"Profile ve Settings üzerine yazılacak."

#: includes/class-ash-admin-ui.php:1931
msgid "Settings JSON file"
msgstr "Ayarlar JSON dosyası"

#: includes/class-ash-admin-ui.php:1931
msgid "Choose file"
msgstr "Dosya seç"

#: includes/class-ash-admin-ui.php:1931
msgid "No file selected"
msgstr "Dosya seçilmedi"

#: includes/class-ash-admin-ui.php:1931
msgid "Import"
msgstr "İçe aktar"

#: includes/class-ash-admin-ui.php:1931
msgid "The export does not include CSP Assistant learning data or scan jobs."
msgstr ""
"Dışa aktarma, CSP Assistant öğrenme verilerini veya tarama işlerini içermez."

#: includes/class-ash-admin-ui.php:1931
msgid "Import settings"
msgstr "Ayarları içe aktar"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Import will replace current plugin settings, including Security Headers, "
"Security Features, Content Security Policy, Security Profile, and Settings. "
"This cannot be undone from this screen."
msgstr ""
"İçe aktarma; Security Headers, Security Features, Content Security Policy, "
"Security Profile ve Settings dahil mevcut eklenti ayarlarının yerini alır. "
"Bu işlem bu ekrandan geri alınamaz."

#: includes/class-ash-admin-ui.php:1931
msgid "Settings file downloaded."
msgstr "Ayarlar dosyası indirildi."

#: includes/class-ash-admin-ui.php:1931
msgid "Settings were imported. The page will reload."
msgstr "Ayarlar içe aktarıldı. Sayfa yeniden yüklenecek."

#: includes/class-ash-admin-ui.php:1931
msgid "Choose a settings JSON file before importing."
msgstr "İçe aktarmadan önce bir ayarlar JSON dosyası seçin."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings transfer could not be completed. Please try again."
msgstr "Ayar aktarımı tamamlanamadı. Lütfen tekrar deneyin."

#: includes/class-ash-admin-ui.php:1931
msgid "The requested settings transfer action is not valid."
msgstr "İstenen ayar aktarma işlemi geçerli değil."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file could not be uploaded. Please try again."
msgstr "Ayarlar dosyası yüklenemedi. Lütfen tekrar deneyin."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file is empty or larger than the allowed size."
msgstr "Ayarlar dosyası boş veya izin verilen boyuttan büyük."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file could not be read."
msgstr "Ayarlar dosyası okunamadı."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file must be a JSON export from this plugin."
msgstr ""
"Ayarlar dosyası bu eklentiden alınmış bir JSON dışa aktarması olmalıdır."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file is not valid JSON."
msgstr "Ayarlar dosyası geçerli bir JSON değil."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file is not a valid Abdal Security Headers export."
msgstr ""
"Ayarlar dosyası geçerli bir Abdal Security Headers dışa aktarması değil."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file does not contain any configuration."
msgstr "Ayarlar dosyası herhangi bir yapılandırma içermiyor."

#: includes/class-ash-admin-ui.php:1931
msgid "The exported Security Headers configuration is not valid."
msgstr "Dışa aktarılan Security Headers yapılandırması geçerli değil."

#: includes/class-ash-admin-ui.php:1931
msgid "The exported plugin settings are not valid."
msgstr "Dışa aktarılan eklenti ayarları geçerli değil."

#: includes/class-ash-admin-ui.php:1931
msgid ""
"The settings could not be imported completely. Previous settings were kept."
msgstr "Ayarlar tamamen içe aktarılamadı. Önceki ayarlar korundu."
