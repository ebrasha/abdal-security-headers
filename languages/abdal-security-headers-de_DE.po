msgid "Removes the public WordPress version from markup, feeds, scripts, and styles."
msgstr "Entfernt die öffentliche WordPress-Version aus Markup, Feeds, Skripten und Styles."

#: includes/class-ash-admin-ui.php
msgid "Replaces detailed login errors with a generic message to reduce user enumeration."
msgstr "Ersetzt detaillierte Login-Fehler durch eine allgemeine Meldung, um Benutzeraufzählung zu erschweren."

#: includes/class-ash-admin-ui.php
msgid "Disables XML-RPC methods and blocks direct access to xmlrpc.php."
msgstr "Deaktiviert XML-RPC-Methoden und blockiert den direkten Zugriff auf xmlrpc.php."

