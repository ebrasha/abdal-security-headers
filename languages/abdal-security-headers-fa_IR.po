msgstr "دستورات CSP"

#: includes/class-ash-admin-ui.php
msgid "General settings"
msgstr "تنظیمات عمومی"

#: includes/class-ash-admin-ui.php
msgid "When enabled, the generated Content-Security-Policy header is sent with HTTP responses."
msgstr "در صورت فعال بودن، هدر Content-Security-Policy تولیدشده همراه با پاسخ‌های HTTP ارسال می‌شود."

#: includes/class-ash-admin-ui.php
msgid "Your changes are not saved automatically."
msgstr "تغییرات شما به‌صورت خودکار ذخیره نمی‌شوند."

#: includes/class-ash-admin-ui.php
msgid "Reset"
msgstr "بازنشانی"

#: includes/class-ash-admin-ui.php
msgid "Save Changes"
msgstr "ذخیره تغییرات"

#: includes/class-ash-admin-ui.php
msgid "Enables the legacy browser XSS filter for older clients."
msgstr "فیلتر XSS مرورگرهای قدیمی را فعال می‌کند."

#: includes/class-ash-admin-ui.php
msgid "Prevents browsers from MIME-sniffing a response away from the declared content type."
msgstr "از حدس زدن نوع محتوا توسط مرورگر جلوگیری می‌کند."

#: includes/class-ash-admin-ui.php
msgid "Forces browsers to use HTTPS for future requests to this host."
msgstr "مرورگر را مجبور می‌کند درخواست‌های بعدی به این میزبان را با HTTPS انجام دهد."

#: includes/class-ash-admin-ui.php
msgid "Restricts access to powerful browser features such as camera and geolocation."
msgstr "دسترسی به قابلیت‌های حساس مرورگر مانند دوربین و موقعیت مکانی را محدود می‌کند."

#: includes/class-ash-admin-ui.php
msgid "Controls whether the site can be embedded in frames to reduce clickjacking risk."
msgstr "امکان قرارگیری سایت در فریم را کنترل می‌کند تا خطر کلیک‌ربایی کاهش یابد."

#: includes/class-ash-admin-ui.php
msgid "Limits referrer information sent with navigations and resource requests."
msgstr "اطلاعات ارجاع ارسال‌شده همراه با پیمایش‌ها و درخواست منابع را محدود می‌کند."

#: includes/class-ash-admin-ui.php
msgid "Hides server technology details exposed by the X-Powered-By header."
msgstr "جزئیات فناوری سرور که توسط هدر X-Powered-By افشا می‌شود را پنهان می‌کند."

#: includes/class-ash-admin-ui.php
msgid "Removes the public WordPress version from markup, feeds, scripts, and styles."
msgstr "نسخه عمومی وردپرس را از نشانه‌گذاری، فیدها، اسکریپت‌ها و استایل‌ها حذف می‌کند."

#: includes/class-ash-admin-ui.php
msgid "Replaces detailed login errors with a generic message to reduce user enumeration."
msgstr "پیام‌های خطای ورود را با یک پیام عمومی جایگزین می‌کند تا شناسایی نام کاربری سخت‌تر شود."

#: includes/class-ash-admin-ui.php
msgid "Disables XML-RPC methods and blocks direct access to xmlrpc.php."
msgstr "روش‌های XML-RPC را غیرفعال می‌کند و دسترسی مستقیم به xmlrpc.php را مسدود می‌کند."

#: includes/class-ash-admin-ui.php
msgid "Removes the X-Pingback response header from WordPress output."
msgstr "هدر پاسخ X-Pingback را از خروجی وردپرس حذف می‌کند."

#: includes/class-ash-admin-ui.php
msgid "Blocks REST API access and removes REST discovery links from the front end."
msgstr "دسترسی REST API را مسدود می‌کند و لینک‌های کشف REST را از بخش عمومی حذف می‌کند."

