#: includes/class-ash-admin-ui.php:1931
msgid ""
"Export or import plugin configuration, and choose what happens to stored "
"data on uninstall."
msgstr ""
"Exporte ou importe a configuração do plugin e escolha o que acontece com os "
"dados armazenados na desinstalação."

#: includes/class-ash-admin-ui.php:1931
msgid "Export and Import"
msgstr "Exportar e importar"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Download a JSON file of all plugin settings, or restore them from a previous"
" export."
msgstr ""
"Baixe um arquivo JSON com todas as configurações do plugin ou restaure-as a "
"partir de uma exportação anterior."

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Export includes Security Headers, Security Features, Content Security "
"Policy, Security Profile, uninstall settings, and CSP Assistant scan "
"exclusions."
msgstr ""
"A exportação inclui Security Headers, Security Features, Content Security "
"Policy, Security Profile, configurações de desinstalação e exclusões de "
"varredura do CSP Assistant."

#: includes/class-ash-admin-ui.php:1931
msgid "Export"
msgstr "Exportar"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Import replaces the current plugin configuration on this site. Choose a JSON"
" file exported from Abdal Security Headers."
msgstr ""
"A importação substitui a configuração atual do plugin neste site. Escolha um"
" arquivo JSON exportado do Abdal Security Headers."

#: includes/class-ash-admin-ui.php:1931
msgid "Import cannot be undone from this screen."
msgstr "A importação não pode ser desfeita nesta tela."

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Security Headers, Security Features, Content Security Policy, Security "
"Profile, and Settings will be overwritten."
msgstr ""
"Security Headers, Security Features, Content Security Policy, Security "
"Profile e Settings serão substituídos."

#: includes/class-ash-admin-ui.php:1931
msgid "Settings JSON file"
msgstr "Arquivo JSON de configurações"

#: includes/class-ash-admin-ui.php:1931
msgid "Choose file"
msgstr "Escolher arquivo"

#: includes/class-ash-admin-ui.php:1931
msgid "No file selected"
msgstr "Nenhum arquivo selecionado"

#: includes/class-ash-admin-ui.php:1931
msgid "Import"
msgstr "Importar"

#: includes/class-ash-admin-ui.php:1931
msgid "The export does not include CSP Assistant learning data or scan jobs."
msgstr ""
"A exportação não inclui dados de aprendizado do CSP Assistant nem tarefas de"
" varredura."

#: includes/class-ash-admin-ui.php:1931
msgid "Import settings"
msgstr "Importar configurações"

#: includes/class-ash-admin-ui.php:1931
msgid ""
"Import will replace current plugin settings, including Security Headers, "
"Security Features, Content Security Policy, Security Profile, and Settings. "
"This cannot be undone from this screen."
msgstr ""
"A importação substituirá as configurações atuais do plugin, incluindo "
"Security Headers, Security Features, Content Security Policy, Security "
"Profile e Settings. Isso não pode ser desfeito nesta tela."

#: includes/class-ash-admin-ui.php:1931
msgid "Settings file downloaded."
msgstr "Arquivo de configurações baixado."

#: includes/class-ash-admin-ui.php:1931
msgid "Settings were imported. The page will reload."
msgstr "As configurações foram importadas. A página será recarregada."

#: includes/class-ash-admin-ui.php:1931
msgid "Choose a settings JSON file before importing."
msgstr "Escolha um arquivo JSON de configurações antes de importar."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings transfer could not be completed. Please try again."
msgstr ""
"Não foi possível concluir a transferência das configurações. Tente "
"novamente."

#: includes/class-ash-admin-ui.php:1931
msgid "The requested settings transfer action is not valid."
msgstr "A ação de transferência de configurações solicitada não é válida."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file could not be uploaded. Please try again."
msgstr "Não foi possível enviar o arquivo de configurações. Tente novamente."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file is empty or larger than the allowed size."
msgstr ""
"O arquivo de configurações está vazio ou é maior do que o tamanho permitido."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file could not be read."
msgstr "Não foi possível ler o arquivo de configurações."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file must be a JSON export from this plugin."
msgstr "O arquivo de configurações deve ser uma exportação JSON deste plugin."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file is not valid JSON."
msgstr "O arquivo de configurações não é um JSON válido."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file is not a valid Abdal Security Headers export."
msgstr ""
"O arquivo de configurações não é uma exportação válida do Abdal Security "
"Headers."

#: includes/class-ash-admin-ui.php:1931
msgid "The settings file does not contain any configuration."
msgstr "O arquivo de configurações não contém nenhuma configuração."

#: includes/class-ash-admin-ui.php:1931
msgid "The exported Security Headers configuration is not valid."
msgstr "A configuração exportada de Security Headers não é válida."

#: includes/class-ash-admin-ui.php:1931
msgid "The exported plugin settings are not valid."
msgstr "As configurações exportadas do plugin não são válidas."

#: includes/class-ash-admin-ui.php:1931
msgid ""
"The settings could not be imported completely. Previous settings were kept."
msgstr ""
"Não foi possível importar as configurações por completo. As configurações "
"anteriores foram mantidas."
